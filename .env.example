# Copy to .env (git-ignored) and fill in YOUR values. Never commit real credentials.
# Variables passed by an MCP client's "env" block take precedence over this file.
#
# This tool is for LOCAL DEVELOPMENT only. HAC_URL must point at localhost or a private-network host
# (127.x, ::1, 10.x, 172.16-31.x, 192.168.x, *.local). Other hosts are refused.

# ---------------------------------------------------------------- SAP Commerce HAC (required for both modes)
# Base URL of HAC including the /hac context path. Default: https://localhost:9002/hac
HAC_URL=https://localhost:9002/hac
HAC_USER=your-hac-user
HAC_PASS=your-hac-password

# Per-request timeout in milliseconds (1000-300000). Default: 30000
#HAC_TIMEOUT_MS=30000

# Local HAC usually uses a self-signed certificate. Set to true ONLY for an authorized local instance.
# Disabled by default. It relaxes TLS verification for HAC requests only (never for AI providers).
#HAC_INSECURE_TLS=true

# Absolute path of the console log file, required only for the logs_tail tool / Console log view.
#HAC_LOG_PATH=/path/to/hybris/log/tomcat/console-YYYYMMDD.log

# Maximum serialized size (characters) of one tool result. Default: 100000
#TOOL_MAX_RESULT_CHARS=100000

# ---------------------------------------------------------------- Web application (npm run start:web)
# Must be a loopback address; anything else is refused. Default: 127.0.0.1
#WEB_HOST=127.0.0.1
# Port (1024-65535). Default: 3737
#WEB_PORT=3737

# ---------------------------------------------------------------- AI providers (web application only)
# Set the keys of the providers you want to use. Direct API use is billed by the provider and is
# separate from any chat or IDE subscription. Keys are read by the server process only.
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=

# Optional: default provider (openai | anthropic | gemini). Default: first provider that has a key.
#AI_DEFAULT_PROVIDER=anthropic

# Optional: model lists offered in the UI (comma separated; the first is the default) and a default model.
# Model ids change over time; verify them in the provider's documentation.
#OPENAI_MODELS=gpt-5.5
#ANTHROPIC_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5
#GEMINI_MODELS=gemini-3.1-pro-preview,gemini-3-flash-preview
#OPENAI_MODEL=
#ANTHROPIC_MODEL=
#GEMINI_MODEL=

# Optional: assistant limits. Defaults shown.
#AI_MAX_TOOL_CALLS=8          # total tool calls per question (1-25)
#AI_MAX_STEPS=10              # model round trips per question (1-30)
#AI_REQUEST_TIMEOUT_MS=120000 # whole-question timeout (5000-600000)
#AI_TOOL_RESULT_CHARS=24000   # characters of one tool result sent back to the model (1000-200000)
